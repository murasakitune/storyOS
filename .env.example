VITE_GOOGLE_CLIENT_ID=000000000000-example.apps.googleusercontent.com
# Electron用にGoogle Cloudで作成した「デスクトップ アプリ」Client ID
VITE_GOOGLE_DESKTOP_CLIENT_ID=000000000000-desktop-example.apps.googleusercontent.com
GOOGLE_DESKTOP_CLIENT_SECRET=desktop-client-secret-from-google-cloud
# Vercel本番URL。末尾は必ず /oauth-callback.html
VITE_GOOGLE_REDIRECT_URI=https://story-os-eta.vercel.app/oauth-callback.html
